<!-- Pogo: a planar one-legged pogo-stick gymnast that learns to backflip.
     Motion is confined to the x-z plane (two slide joints + one UNLIMITED hinge
     for the torso, so it can rotate through a full 360 flip). Leg has three
     actuated hinges (hip / knee / ankle) for crouch, launch and tuck. A small
     painted face (collision-free geoms) makes the demo readable. -->
<mujoco model="pogo">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option integrator="RK4" timestep="0.002"/>

  <default>
    <joint armature="0.5" damping="1" limited="true"/>
    <geom conaffinity="0" condim="3" contype="1" margin="0.001"
          friction="0.9 0.1 0.1" solimp=".8 .8 .01" solref=".02 1" rgba="0.9 0.5 0.15 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.5 0.7 0.9" rgb2="0.05 0.08 0.12"
             width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.16 0.20 0.26" rgb2="0.22 0.28 0.36"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 4" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" conaffinity="1" contype="1" condim="3"
          size="30 5 0.1" pos="0 0 0" material="grid" friction="0.9 0.1 0.1"/>

    <body name="torso" pos="0 0 0">
      <!-- torso home at z=0 so the rootz slide IS the true world height of the torso
           (reward/termination read rootz as torso_z). init_height puts the foot on
           the floor at reset, so Pogo starts STANDING and can crouch, launch and flip. -->
      <!-- planar root: x-slide, z-slide, y-hinge (the flip axis, UNLIMITED) -->
      <joint name="rootx" type="slide" axis="1 0 0" limited="false" armature="0" damping="0"/>
      <joint name="rootz" type="slide" axis="0 0 1" limited="false" armature="0" damping="0"/>
      <joint name="rooty" type="hinge" axis="0 1 0" limited="false" armature="0" damping="0"/>

      <geom name="torso_geom" type="capsule" fromto="0 0 -0.12 0 0 0.12" size="0.075"/>
      <!-- face (visual only: contype=0 conaffinity=0 so it never collides) -->
      <geom name="eye_l" type="sphere" size="0.028" pos="0.055 0.02 0.06" contype="0" conaffinity="0" rgba="1 1 1 1"/>
      <geom name="eye_r" type="sphere" size="0.028" pos="0.055 -0.02 0.06" contype="0" conaffinity="0" rgba="1 1 1 1"/>
      <geom name="pupil_l" type="sphere" size="0.013" pos="0.075 0.02 0.06" contype="0" conaffinity="0" rgba="0.05 0.05 0.05 1"/>
      <geom name="pupil_r" type="sphere" size="0.013" pos="0.075 -0.02 0.06" contype="0" conaffinity="0" rgba="0.05 0.05 0.05 1"/>

      <body name="thigh" pos="0 0 -0.12">
        <joint name="hip" type="hinge" axis="0 1 0" range="-150 20"/>
        <geom name="thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.05"/>
        <body name="leg" pos="0 0 -0.30">
          <joint name="knee" type="hinge" axis="0 1 0" range="-150 0"/>
          <geom name="leg_geom" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.04"/>
          <body name="foot" pos="0 0 -0.30">
            <joint name="ankle" type="hinge" axis="0 1 0" range="-50 50"/>
            <geom name="foot_geom" type="capsule" fromto="-0.07 0 0 0.16 0 0" size="0.06"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="hip_motor"   joint="hip"   gear="200"/>
    <motor name="knee_motor"  joint="knee"  gear="200"/>
    <motor name="ankle_motor" joint="ankle" gear="200"/>
  </actuator>
</mujoco>
